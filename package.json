{
  "name": "sublime-knob-exhibition",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive exhibition of the Sublime Knob instrument.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-public.mjs",
    "test:browser": "playwright test",
    "validate": "npm run format:check && npm run test && npm run build && npm run check && npm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1",
    "vite": "8.3.8"
  }
}
